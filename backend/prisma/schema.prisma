generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum UserStatus {
  pending_verification
  active
  suspended
}

enum AccountType {
  individual
  corporate
  fleet
}

enum UserRole {
  customer
  partner
  admin_super
  admin_ops
  admin_inspection
  admin_support
  accountant
  accounts_manager
  admin_partner_manager
  admin_content
  admin_compliance
  admin_analyst
}

enum OwnershipType {
  personal
  company
  fleet
}

enum DocumentType {
  registration
  insurance
  warranty
  ownership_transfer
  other
}

enum InspectionStatus {
  booked
  assigned
  in_progress
  submitted
  qa_review
  completed
  cancelled
}

enum CheckpointCategory {
  engine
  transmission
  chassis
  brakes
  suspension
  steering
  electrical
  battery
  ac
  tires
  wheels
  interior
  exterior
  fluids
  paint_thickness
  obd
  road_test
}

enum CheckpointResult {
  pass
  minor_defect
  critical_defect
  not_applicable
}

enum OverallStatus {
  green
  amber
  red
}

enum AiRecommendation {
  buy
  buy_after_negotiation
  proceed_with_caution
  do_not_buy
}

enum MediaType {
  photo
  video
}

enum PartnerType {
  garage
  inspector
  insurer
  warranty_provider
  finance_provider
  roadside_provider
  detailer
  transporter
}

enum PartnerStatus {
  pending
  verified
  rejected
  suspended
}

enum BookingType {
  service
  inspection
  roadside
  concierge
}

enum BookingStatus {
  pending
  confirmed
  in_progress
  completed
  cancelled
  payment_pending
}

enum PaymentMethod {
  card
  apple_pay
  google_pay
  pay_at_service
}

enum PaymentProvider {
  stripe
  local_gateway
  none
}

enum PaymentStatus {
  pending
  captured
  failed
  refunded
}

enum RelatedEntityType {
  booking
  inspection
  warranty_policy
  insurance_policy
  roadside_request
}

enum NotificationChannel {
  push
  sms
  email
  whatsapp
}

enum ConversationRole {
  user
  assistant
}

enum RewardsTransactionReason {
  referral_bonus
  booking_completed
  promo_credit
  redemption
  manual_adjustment
}

enum ReferralStatus {
  pending
  completed
}

enum SupportTicketStatus {
  open
  in_progress
  resolved
  closed
}

enum WarrantyPolicyStatus {
  active
  expired
  cancelled
}

enum WarrantyClaimStatus {
  submitted
  under_review
  inspection_required
  approved
  rejected
  repair_authorized
  completed
  closed
}

enum InsuranceIntegrationType {
  manual
  api
}

enum InsuranceQuoteStatus {
  requested
  quoted
  expired
}

enum InsurancePolicyStatus {
  active
  expired
  cancelled
}

enum RoadsideServiceType {
  tow
  jumpstart
  flat_tire
  fuel_delivery
  lockout
}

enum RoadsideStatus {
  requested
  matched
  accepted
  en_route
  arrived
  in_service
  completed
  cancelled
}

enum ConciergeOrderType {
  registration_renewal
  ownership_transfer
  pickup_delivery
  detailing
  driver_service
}

enum ConciergeStatus {
  requested
  assigned
  in_progress
  completed
  cancelled
}

enum ListingSellerType {
  certified
  dealer
  private
}

enum ListingStatus {
  draft
  active
  reserved
  sold
  withdrawn
}

// ---------- Models ----------

model User {
  id                String      @id @default(uuid())
  email             String      @unique
  phoneNumber       String?     @unique @map("phone_number")
  fullName          String      @map("full_name")
  preferredLanguage String      @default("en") @map("preferred_language")
  emirate           String?
  status            UserStatus  @default(pending_verification)
  accountType       AccountType @default(individual) @map("account_type")
  role              UserRole    @default(customer)
  passwordHash      String      @map("password_hash")
  profilePhotoUrl   String?     @map("profile_photo_url")
  referralCode      String?     @unique @map("referral_code")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  vehicleOwners      VehicleOwner[]
  otpCodes           OtpCode[]
  bookingsAsCustomer Booking[]                @relation("BookingCustomer")
  inspectionRequests Inspection[]             @relation("InspectionRequester")
  notifications      Notification[]
  notificationPrefs  NotificationPreference[]
  aiConversations    AiConversation[]
  reviews            Review[]
  rewardsAccount     RewardsAccount?
  supportTickets     SupportTicket[]
  refreshTokens      RefreshToken[]
  partnerProfile     Partner?
  referralsMade      Referral[]               @relation("ReferralsMade")
  referredBy         Referral?                @relation("ReferralsReceived")
  warrantyPolicies   WarrantyPolicy[]
  insuranceQuotes    InsuranceQuote[]
  roadsideRequests   RoadsideRequest[]
  conciergeOrders    ConciergeOrder[]
  vehicleListings    VehicleListing[]
  deviceTokens       DeviceToken[]
  invoices           Invoice[]

  @@map("users")
}

model DeviceToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  platform  String
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("device_tokens")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @map("token_hash")
  expiresAt DateTime @map("expires_at")
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("refresh_tokens")
}

/// One-time codes used for password reset (identifier is the account email).
model OtpCode {
  id         String   @id @default(uuid())
  userId     String?  @map("user_id")
  identifier String
  codeHash   String   @map("code_hash")
  purpose    String   @default("password_reset")
  expiresAt  DateTime @map("expires_at")
  attempts   Int      @default(0)
  consumed   Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([identifier])
  @@map("otp_codes")
}

model Vehicle {
  id                   String    @id @default(uuid())
  vin                  String?   @unique
  plateNumber          String    @map("plate_number")
  emirateRegistered    String    @map("emirate_registered")
  make                 String
  model                String
  year                 Int
  bodyType             String?   @map("body_type")
  fuelType             String?   @map("fuel_type")
  transmission         String?
  gccSpec              Boolean   @default(true) @map("gcc_spec")
  color                String?
  mileageKm            Int?      @map("mileage_km")
  primaryPhotoUrl      String?   @map("primary_photo_url")
  healthScore          Int?      @map("health_score")
  healthScoreUpdatedAt DateTime? @map("health_score_updated_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  owners           VehicleOwner[]
  documents        VehicleDocument[]
  inspections      Inspection[]
  bookings         Booking[]
  warrantyPolicies WarrantyPolicy[]
  insuranceQuotes  InsuranceQuote[]
  roadsideRequests RoadsideRequest[]
  conciergeOrders  ConciergeOrder[]
  listings         VehicleListing[]

  @@map("vehicles")
}

model VehicleOwner {
  id            String        @id @default(uuid())
  vehicleId     String        @map("vehicle_id")
  userId        String        @map("user_id")
  ownershipType OwnershipType @default(personal) @map("ownership_type")
  isPrimary     Boolean       @default(true) @map("is_primary")
  addedAt       DateTime      @default(now()) @map("added_at")

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@unique([vehicleId, userId])
  @@map("vehicle_owners")
}

model VehicleDocument {
  id         String       @id @default(uuid())
  vehicleId  String       @map("vehicle_id")
  type       DocumentType
  fileUrl    String       @map("file_url")
  issuedDate DateTime?    @map("issued_date")
  expiryDate DateTime?    @map("expiry_date")
  uploadedBy String?      @map("uploaded_by")
  verified   Boolean      @default(false)
  createdAt  DateTime     @default(now()) @map("created_at")

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])

  @@index([vehicleId, expiryDate])
  @@map("vehicle_documents")
}

model Partner {
  id               String        @id @default(uuid())
  userId           String?       @unique @map("user_id")
  businessName     String        @map("business_name")
  partnerType      PartnerType   @map("partner_type")
  status           PartnerStatus @default(pending)
  contactPhone     String?       @map("contact_phone")
  contactEmail     String?       @map("contact_email")
  tradeLicenseUrl  String?       @map("trade_license_url")
  ratingAvg        Float         @default(0) @map("rating_avg")
  cancellationRate Float         @default(0) @map("cancellation_rate")
  latitude         Float?
  longitude        Float?
  verifiedAt       DateTime?     @map("verified_at")
  createdAt        DateTime      @default(now()) @map("created_at")

  user                    User?             @relation(fields: [userId], references: [id])
  services                PartnerService[]
  inspections             Inspection[]
  bookings                Booking[]
  reviews                 Review[]
  warrantyPlans           WarrantyPlan[]
  warrantyClaimsAssigned  WarrantyClaim[]
  roadsideRequests        RoadsideRequest[]
  conciergeOrdersAssigned ConciergeOrder[]

  @@map("partners")
}

model PartnerService {
  id                      String  @id @default(uuid())
  partnerId               String  @map("partner_id")
  serviceCategory         String  @map("service_category")
  price                   Float
  durationEstimateMinutes Int?    @map("duration_estimate_minutes")
  active                  Boolean @default(true)

  partner Partner @relation(fields: [partnerId], references: [id])

  @@index([partnerId, serviceCategory])
  @@map("partner_services")
}

model Inspection {
  id               String           @id @default(uuid())
  vehicleId        String?          @map("vehicle_id")
  requesterId      String           @map("requester_id")
  inspectorId      String?          @map("inspector_id")
  rawPlateNumber   String?          @map("raw_plate_number")
  rawMakeModelYear String?          @map("raw_make_model_year")
  status           InspectionStatus @default(booked)
  scheduledAt      DateTime         @map("scheduled_at")
  locationLat      Float?           @map("location_lat")
  locationLng      Float?           @map("location_lng")
  locationAddress  String?          @map("location_address")
  priceAmount      Float            @map("price_amount")
  currency         String           @default("AED")
  paymentId        String?          @map("payment_id")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  vehicle     Vehicle?               @relation(fields: [vehicleId], references: [id])
  requester   User                   @relation("InspectionRequester", fields: [requesterId], references: [id])
  inspector   Partner?               @relation(fields: [inspectorId], references: [id])
  checkpoints InspectionCheckpoint[]
  media       InspectionMedia[]
  report      InspectionReport?
  listing     VehicleListing?

  @@index([status, scheduledAt])
  @@map("inspections")
}

model InspectionCheckpoint {
  id             String             @id @default(uuid())
  inspectionId   String             @map("inspection_id")
  category       CheckpointCategory
  checkpointName String             @map("checkpoint_name")
  result         CheckpointResult   @default(pass)
  notes          String?

  inspection Inspection        @relation(fields: [inspectionId], references: [id])
  media      InspectionMedia[]

  @@index([inspectionId, category])
  @@map("inspection_checkpoints")
}

model InspectionMedia {
  id           String    @id @default(uuid())
  inspectionId String    @map("inspection_id")
  checkpointId String?   @map("checkpoint_id")
  type         MediaType
  fileUrl      String    @map("file_url")
  capturedAt   DateTime  @default(now()) @map("captured_at")

  inspection Inspection            @relation(fields: [inspectionId], references: [id])
  checkpoint InspectionCheckpoint? @relation(fields: [checkpointId], references: [id])

  @@map("inspection_media")
}

model InspectionReport {
  id                  String            @id @default(uuid())
  inspectionId        String            @unique @map("inspection_id")
  overallScore        Float             @map("overall_score")
  overallStatus       OverallStatus     @map("overall_status")
  categoryScores      Json              @map("category_scores")
  criticalDefectCount Int               @default(0) @map("critical_defect_count")
  minorDefectCount    Int               @default(0) @map("minor_defect_count")
  estimatedRepairCost Float             @default(0) @map("estimated_repair_cost")
  aiSummary           String?           @map("ai_summary")
  aiRecommendation    AiRecommendation? @map("ai_recommendation")
  obdData             Json?             @map("obd_data")
  roadTestNotes       String?           @map("road_test_notes")
  generatedAt         DateTime          @default(now()) @map("generated_at")

  inspection Inspection @relation(fields: [inspectionId], references: [id])

  @@map("inspection_reports")
}

model Booking {
  id                      String        @id @default(uuid())
  bookingType             BookingType   @map("booking_type")
  vehicleId               String        @map("vehicle_id")
  customerId              String        @map("customer_id")
  partnerId               String?       @map("partner_id")
  serviceCategory         String?       @map("service_category")
  status                  BookingStatus @default(pending)
  scheduledAt             DateTime      @map("scheduled_at")
  pickupDeliveryRequested Boolean       @default(false) @map("pickup_delivery_requested")
  totalAmount             Float         @map("total_amount")
  currency                String        @default("AED")
  paymentId               String?       @map("payment_id")
  createdAt               DateTime      @default(now()) @map("created_at")
  updatedAt               DateTime      @updatedAt @map("updated_at")

  vehicle       Vehicle                @relation(fields: [vehicleId], references: [id])
  customer      User                   @relation("BookingCustomer", fields: [customerId], references: [id])
  partner       Partner?               @relation(fields: [partnerId], references: [id])
  statusHistory BookingStatusHistory[]
  review        Review?

  @@index([status, scheduledAt])
  @@map("bookings")
}

model BookingStatusHistory {
  id        String        @id @default(uuid())
  bookingId String        @map("booking_id")
  status    BookingStatus
  changedBy String?       @map("changed_by")
  changedAt DateTime      @default(now()) @map("changed_at")

  booking Booking @relation(fields: [bookingId], references: [id])

  @@map("booking_status_history")
}

model Payment {
  id                String            @id @default(uuid())
  relatedEntityType RelatedEntityType @map("related_entity_type")
  relatedEntityId   String            @map("related_entity_id")
  customerId        String            @map("customer_id")
  amount            Float
  currency          String            @default("AED")
  vatAmount         Float             @default(0) @map("vat_amount")
  paymentMethod     PaymentMethod     @map("payment_method")
  provider          PaymentProvider   @default(none)
  providerReference String?           @map("provider_reference")
  status            PaymentStatus     @default(pending)
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  invoice Invoice?

  @@index([customerId])
  @@map("payments")
}

enum InvoiceStatus {
  issued
  refunded
  void
}

model Invoice {
  id            String        @id @default(uuid())
  invoiceNumber String        @unique @map("invoice_number")
  paymentId     String        @unique @map("payment_id")
  customerId    String        @map("customer_id")
  description   String
  subtotal      Float
  vatAmount     Float         @map("vat_amount")
  totalAmount   Float         @map("total_amount")
  currency      String        @default("AED")
  status        InvoiceStatus @default(issued)
  issuedAt      DateTime      @default(now()) @map("issued_at")
  createdAt     DateTime      @default(now()) @map("created_at")

  payment  Payment @relation(fields: [paymentId], references: [id])
  customer User    @relation(fields: [customerId], references: [id])

  @@index([customerId])
  @@map("invoices")
}

model Notification {
  id                String              @id @default(uuid())
  userId            String              @map("user_id")
  category          String
  channel           NotificationChannel
  title             String
  body              String
  relatedEntityType String?             @map("related_entity_type")
  relatedEntityId   String?             @map("related_entity_id")
  readAt            DateTime?           @map("read_at")
  sentAt            DateTime            @default(now()) @map("sent_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId, readAt])
  @@map("notifications")
}

model NotificationPreference {
  id       String              @id @default(uuid())
  userId   String              @map("user_id")
  category String
  channel  NotificationChannel
  enabled  Boolean             @default(true)

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, category, channel])
  @@map("notification_preferences")
}

model AiConversation {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  vehicleId String?  @map("vehicle_id")
  startedAt DateTime @default(now()) @map("started_at")

  user     User        @relation(fields: [userId], references: [id])
  messages AiMessage[]

  @@map("ai_conversations")
}

model AiMessage {
  id                   String           @id @default(uuid())
  conversationId       String           @map("conversation_id")
  role                 ConversationRole
  content              String
  referencedEntityType String?          @map("referenced_entity_type")
  referencedEntityId   String?          @map("referenced_entity_id")
  createdAt            DateTime         @default(now()) @map("created_at")

  conversation AiConversation @relation(fields: [conversationId], references: [id])

  @@map("ai_messages")
}

model Review {
  id         String  @id @default(uuid())
  bookingId  String  @unique @map("booking_id")
  reviewerId String  @map("reviewer_id")
  partnerId  String  @map("partner_id")
  rating     Int
  comment    String?

  booking  Booking @relation(fields: [bookingId], references: [id])
  reviewer User    @relation(fields: [reviewerId], references: [id])
  partner  Partner @relation(fields: [partnerId], references: [id])

  @@map("reviews")
}

model RewardsAccount {
  id            String @id @default(uuid())
  userId        String @unique @map("user_id")
  pointsBalance Int    @default(0) @map("points_balance")

  user         User                 @relation(fields: [userId], references: [id])
  transactions RewardsTransaction[]

  @@map("rewards_accounts")
}

model RewardsTransaction {
  id               String                   @id @default(uuid())
  rewardsAccountId String                   @map("rewards_account_id")
  points           Int
  reason           RewardsTransactionReason
  relatedEntityId  String?                  @map("related_entity_id")
  createdAt        DateTime                 @default(now()) @map("created_at")

  rewardsAccount RewardsAccount @relation(fields: [rewardsAccountId], references: [id])

  @@index([rewardsAccountId])
  @@map("rewards_transactions")
}

model Referral {
  id             String         @id @default(uuid())
  referrerId     String         @map("referrer_id")
  referredUserId String         @unique @map("referred_user_id")
  status         ReferralStatus @default(pending)
  rewardIssued   Boolean        @default(false) @map("reward_issued")
  createdAt      DateTime       @default(now()) @map("created_at")

  referrer     User @relation("ReferralsMade", fields: [referrerId], references: [id])
  referredUser User @relation("ReferralsReceived", fields: [referredUserId], references: [id])

  @@index([referrerId])
  @@map("referrals")
}

model SupportTicket {
  id              String              @id @default(uuid())
  userId          String              @map("user_id")
  category        String
  subject         String
  status          SupportTicketStatus @default(open)
  assignedAdminId String?             @map("assigned_admin_id")
  createdAt       DateTime            @default(now()) @map("created_at")

  user     User                   @relation(fields: [userId], references: [id])
  messages SupportTicketMessage[]

  @@map("support_tickets")
}

model SupportTicketMessage {
  id         String   @id @default(uuid())
  ticketId   String   @map("ticket_id")
  authorId   String   @map("author_id")
  authorRole String   @map("author_role")
  content    String
  createdAt  DateTime @default(now()) @map("created_at")

  ticket SupportTicket @relation(fields: [ticketId], references: [id])

  @@index([ticketId])
  @@map("support_ticket_messages")
}

model AdminAuditLog {
  id          String   @id @default(uuid())
  adminUserId String   @map("admin_user_id")
  action      String
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id")
  beforeState Json?    @map("before_state")
  afterState  Json?    @map("after_state")
  ipAddress   String?  @map("ip_address")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("admin_audit_log")
}

model WarrantyPlan {
  id                String   @id @default(uuid())
  providerPartnerId String   @map("provider_partner_id")
  name              String
  coverageSummary   String   @map("coverage_summary")
  exclusions        String?
  eligibilityRules  Json?    @map("eligibility_rules")
  price             Float
  active            Boolean  @default(true)
  createdAt         DateTime @default(now()) @map("created_at")

  providerPartner Partner          @relation(fields: [providerPartnerId], references: [id])
  policies        WarrantyPolicy[]

  @@map("warranty_plans")
}

model WarrantyPolicy {
  id           String               @id @default(uuid())
  planId       String               @map("plan_id")
  vehicleId    String               @map("vehicle_id")
  customerId   String               @map("customer_id")
  policyNumber String               @unique @map("policy_number")
  startDate    DateTime             @map("start_date")
  endDate      DateTime             @map("end_date")
  status       WarrantyPolicyStatus @default(active)
  documentUrl  String?              @map("document_url")
  createdAt    DateTime             @default(now()) @map("created_at")

  plan     WarrantyPlan    @relation(fields: [planId], references: [id])
  vehicle  Vehicle         @relation(fields: [vehicleId], references: [id])
  customer User            @relation(fields: [customerId], references: [id])
  claims   WarrantyClaim[]

  @@index([customerId])
  @@map("warranty_policies")
}

model WarrantyClaim {
  id               String              @id @default(uuid())
  policyId         String              @map("policy_id")
  description      String
  status           WarrantyClaimStatus @default(submitted)
  assignedGarageId String?             @map("assigned_garage_id")
  rejectionReason  String?             @map("rejection_reason")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  policy         WarrantyPolicy          @relation(fields: [policyId], references: [id])
  assignedGarage Partner?                @relation(fields: [assignedGarageId], references: [id])
  documents      WarrantyClaimDocument[]

  @@index([policyId])
  @@map("warranty_claims")
}

model WarrantyClaimDocument {
  id      String @id @default(uuid())
  claimId String @map("claim_id")
  fileUrl String @map("file_url")
  type    String

  claim WarrantyClaim @relation(fields: [claimId], references: [id])

  @@map("warranty_claim_documents")
}

model InsuranceProvider {
  id              String                   @id @default(uuid())
  name            String
  integrationType InsuranceIntegrationType @default(manual) @map("integration_type")
  active          Boolean                  @default(true)

  quotes InsuranceQuote[]

  @@map("insurance_providers")
}

model InsuranceQuote {
  id            String               @id @default(uuid())
  vehicleId     String               @map("vehicle_id")
  customerId    String               @map("customer_id")
  providerId    String               @map("provider_id")
  premiumAmount Float?               @map("premium_amount")
  coverageType  String?              @map("coverage_type")
  excessAmount  Float?               @map("excess_amount")
  validUntil    DateTime?            @map("valid_until")
  status        InsuranceQuoteStatus @default(requested)
  createdAt     DateTime             @default(now()) @map("created_at")

  vehicle  Vehicle           @relation(fields: [vehicleId], references: [id])
  customer User              @relation(fields: [customerId], references: [id])
  provider InsuranceProvider @relation(fields: [providerId], references: [id])
  policy   InsurancePolicy?

  @@index([customerId])
  @@map("insurance_quotes")
}

model InsurancePolicy {
  id             String                @id @default(uuid())
  quoteId        String                @unique @map("quote_id")
  policyNumber   String                @unique @map("policy_number")
  startDate      DateTime              @map("start_date")
  endDate        DateTime              @map("end_date")
  documentUrl    String?               @map("document_url")
  digitalCardUrl String?               @map("digital_card_url")
  status         InsurancePolicyStatus @default(active)
  createdAt      DateTime              @default(now()) @map("created_at")

  quote InsuranceQuote @relation(fields: [quoteId], references: [id])

  @@map("insurance_policies")
}

model RoadsideRequest {
  id          String              @id @default(uuid())
  vehicleId   String              @map("vehicle_id")
  customerId  String              @map("customer_id")
  serviceType RoadsideServiceType @map("service_type")
  status      RoadsideStatus      @default(requested)
  locationLat Float               @map("location_lat")
  locationLng Float               @map("location_lng")
  providerId  String?             @map("provider_id")
  requestedAt DateTime            @default(now()) @map("requested_at")
  completedAt DateTime?           @map("completed_at")

  vehicle  Vehicle  @relation(fields: [vehicleId], references: [id])
  customer User     @relation(fields: [customerId], references: [id])
  provider Partner? @relation(fields: [providerId], references: [id])

  @@index([customerId])
  @@index([status])
  @@map("roadside_requests")
}

model ConciergeOrder {
  id                String             @id @default(uuid())
  orderType         ConciergeOrderType @map("order_type")
  vehicleId         String             @map("vehicle_id")
  customerId        String             @map("customer_id")
  status            ConciergeStatus    @default(requested)
  assignedPartnerId String?            @map("assigned_partner_id")
  assignedAdminId   String?            @map("assigned_admin_id")
  documentChecklist Json?              @map("document_checklist")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  vehicle         Vehicle  @relation(fields: [vehicleId], references: [id])
  customer        User     @relation(fields: [customerId], references: [id])
  assignedPartner Partner? @relation(fields: [assignedPartnerId], references: [id])

  @@index([customerId])
  @@map("concierge_orders")
}

model VehicleListing {
  id           String            @id @default(uuid())
  vehicleId    String?           @map("vehicle_id")
  sellerId     String?           @map("seller_id")
  sellerType   ListingSellerType @default(certified) @map("seller_type")
  make         String
  model        String
  year         Int
  mileageKm    Int?              @map("mileage_km")
  askingPrice  Float             @map("asking_price")
  inspectionId String?           @unique @map("inspection_id")
  status       ListingStatus     @default(draft)
  photos       Json?
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  vehicle    Vehicle?    @relation(fields: [vehicleId], references: [id])
  seller     User?       @relation(fields: [sellerId], references: [id])
  inspection Inspection? @relation(fields: [inspectionId], references: [id])

  @@index([status])
  @@map("vehicle_listings")
}

enum CouponDiscountType {
  percentage
  fixed_amount
}

model CmsContent {
  id        String   @id @default(uuid())
  section   String
  locale    String   @default("en")
  title     String
  body      String
  order     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([section, locale])
  @@map("cms_content")
}

model Coupon {
  id             String             @id @default(uuid())
  code           String             @unique
  description    String?
  discountType   CouponDiscountType @map("discount_type")
  discountValue  Float              @map("discount_value")
  maxRedemptions Int?               @map("max_redemptions")
  redeemedCount  Int                @default(0) @map("redeemed_count")
  expiresAt      DateTime?          @map("expires_at")
  active         Boolean            @default(true)
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  @@map("coupons")
}
