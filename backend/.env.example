# Copy to .env and adjust as needed.

# Matches docker-compose.yml defaults
DATABASE_URL="postgresql://car_nanny:car_nanny_dev_password@localhost:5432/car_nanny?schema=public"

PORT=3000
NODE_ENV=development

JWT_ACCESS_SECRET=dev-access-secret-change-me

# Optional — leave unset to run payments in dev-simulation mode
STRIPE_SECRET_KEY=
# Required only once STRIPE_SECRET_KEY is set, to verify webhook calls really
# came from Stripe (find it in the Stripe Dashboard's webhook endpoint config).
STRIPE_WEBHOOK_SECRET=

# Notifications — all optional. Leave unset to log deliveries instead of
# actually sending them (see backend/src/notifications/providers/*.ts).
# Push: the full Firebase service-account JSON, as a single-line string.
FIREBASE_SERVICE_ACCOUNT_JSON=
# SMS / WhatsApp (Twilio):
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM_NUMBER=
TWILIO_WHATSAPP_FROM_NUMBER=
# Email (any SMTP provider — SES, SendGrid SMTP relay, Gmail app password, etc.):
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=

# File storage (Cloudflare R2) — all optional. Leave unset and uploads are
# written to ./uploads and served from /uploads instead of the bucket, so the
# app works locally without credentials (see backend/src/storage/storage.provider.ts).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public base URL for the bucket (its r2.dev dev URL, or a custom domain).
# Only listing and vehicle photos use this; documents are always served through
# short-lived signed URLs and never from a public address.
R2_PUBLIC_BASE_URL=
# Used to build absolute URLs for the local-disk fallback; defaults to
# http://localhost:$PORT. Irrelevant once R2 is configured.
PUBLIC_BASE_URL=
